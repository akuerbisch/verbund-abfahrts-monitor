# Required client identifier for the Verbundlinie VAO/HAFAS StationBoard API.
# Server-side only — never expose this via a NEXT_PUBLIC_ prefix.
VAO_AID=

# GitLab access token (read_api scope) for the merge-requests card.
# Server-side only — never expose this via a NEXT_PUBLIC_ prefix.
GITLAB_ACCESS_TOKEN=

# GitLab instance root. Defaults to https://gitlab.wirecube.at in code if unset.
GITLAB_BASE_URL=

# Jira Cloud API token *with scopes* for the release-versions card. Sent as
# Basic auth (email:token) against the api.atlassian.com gateway — not
# against the site domain, which scoped tokens don't support (it silently
# falls back to an unauthenticated, permission-less context instead of
# erroring).
# Server-side only — never expose this via a NEXT_PUBLIC_ prefix.
JIRA_TOKEN=

# Email address of the Atlassian account the token belongs to.
JIRA_EMAIL=

# Jira site root, used to resolve the site's cloud id (via /_edge/tenant_info)
# for the api.atlassian.com gateway. Defaults to https://wirecube.atlassian.net
# in code if unset. Note: NOT the /jira/ path shown in the browser.
JIRA_BASE_URL=
