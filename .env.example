# Required client identifier for the Verbundlinie VAO/HAFAS StationBoard API.
# Server-side only — never expose this via a NEXT_PUBLIC_ prefix.
VAO_AID=

# GitLab instance root. Defaults to https://gitlab.wirecube.at in code if unset.
GITLAB_BASE_URL=

# Jira site root, used to resolve the site's cloud id (via /_edge/tenant_info)
# for the api.atlassian.com gateway. Defaults to https://wirecube.atlassian.net
# in code if unset. Note: NOT the /jira/ path shown in the browser.
JIRA_BASE_URL=

# GitLab access token and Jira email/API token are intentionally NOT server
# env vars. This app has no visitor auth of its own, so a server-held token
# would be usable by anyone who has the deployed URL. Instead, each browser
# supplies its own credentials (entered via the key icon in the header),
# stored only in that browser's localStorage and sent only as a per-request
# header — the server never holds a standing secret for either provider.
