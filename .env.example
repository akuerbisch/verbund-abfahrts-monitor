# Required client identifier for the Verbundlinie VAO/HAFAS StationBoard API.
# Server-side only — never expose this via a NEXT_PUBLIC_ prefix.
VAO_AID=

# GitLab access token (read_api scope) for the merge-requests card.
# Server-side only — never expose this via a NEXT_PUBLIC_ prefix.
GITLAB_ACCESS_TOKEN=

# GitLab instance root. Defaults to https://gitlab.wirecube.at in code if unset.
GITLAB_BASE_URL=

# Jira Cloud API token for the release-versions card.
# Server-side only — never expose this via a NEXT_PUBLIC_ prefix.
JIRA_TOKEN=

# Email address of the Atlassian account the token belongs to (Jira Cloud
# Basic auth requires email:token, not the token alone).
JIRA_EMAIL=

# Jira site root. Defaults to https://wirecube.atlassian.net in code if unset.
# Note: NOT the /jira/ path shown in the browser — the REST API lives at the site root.
JIRA_BASE_URL=
